<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg_dark"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/cyber_card_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp">

        <ImageView
            android:id="@+id/btn_cyber_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_clear"
            app:tint="@color/cyber_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ad-free player"
                android:textColor="@color/cyber_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ads are removed while you watch"
                android:textColor="@color/cyber_neon_green"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_brave_shield_badge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="ON"
            android:textColor="@color/cyber_neon_green"
            android:textSize="10sp"
            android:textStyle="bold"
            app:chipBackgroundColor="@color/cyber_card_dark"
            app:chipIcon="@drawable/ic_shield_check"
            app:chipIconTint="@color/cyber_neon_green"
            app:chipStrokeColor="@color/cyber_neon_green"
            app:chipStrokeWidth="1dp" />

        <ImageView
            android:id="@+id/btn_cyber_reload"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:padding="6dp"
            android:src="@drawable/ic_clear"
            android:rotation="45"
            app:tint="@color/cyber_cyan" />
    </LinearLayout>

    <!-- Platform Selector Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0C1220"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_youtube"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:text="YouTube"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#20FF0000"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_youtube"
                app:iconTint="#FF0000"
                app:strokeColor="#FF0000"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_spotify"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Spotify"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#201DB954"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_spotify"
                app:iconTint="#1DB954"
                app:strokeColor="#1DB954"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_ytmusic"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:text="YT Music"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#20FF0000"
                app:cornerRadius="19dp"
                app:icon="@drawable/ic_youtube"
                app:iconTint="#FF0000"
                app:strokeColor="#FF0000"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Page Loading Progress -->
    <ProgressBar
        android:id="@+id/cyber_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/cyber_cyan"
        android:visibility="gone" />

    <!-- Container for WebView and Fullscreen Media View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/cyber_web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/cyber_bg_dark" />

        <FrameLayout
            android:id="@+id/cyber_fullscreen_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
