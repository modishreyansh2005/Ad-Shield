<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/theme_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dialog_app_icon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            tools:src="@drawable/ic_youtube" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialog_app_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/theme_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="YouTube Ad Shield" />

            <TextView
                android:id="@+id/dialog_app_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACTIVE • DNS FILTERING"
                android:textColor="@color/status_allowed"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="?attr/theme_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/theme_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRACKING &amp; AD REQUESTS SINKHOLED"
                android:textColor="?attr/theme_text_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_app_blocked_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/status_blocked"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="48" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Technical Transparency Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="?attr/theme_bg"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/theme_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TECHNICAL TRANSPARENCY"
                android:textColor="?attr/theme_accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dialog_app_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:textColor="?attr/theme_text_secondary"
                android:textSize="12sp"
                tools:text="AdShield blocks advertising, telemetry, and banner endpoints at the DNS level. Legitimate streaming servers (googlevideo.com) are strictly protected to ensure smooth playback without buffering." />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialog_btn_launch_hub"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Launch in Ad-Free Cyber Hub (Brave Engine)"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        app:backgroundTint="#2600E5FF"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_apps"
        app:iconTint="@color/cyber_cyan"
        app:strokeColor="@color/cyber_cyan"
        app:strokeWidth="1dp" />

    <Button
        android:id="@+id/dialog_btn_close"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="?attr/theme_accent"
        android:text="Understood"
        android:textColor="@android:color/white" />

</LinearLayout>
