<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/theme_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/dialog_rule_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Filter Rule"
        android:textColor="?attr/theme_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter a fully qualified domain name (e.g., ads.example.com)"
        android:textColor="?attr/theme_text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_rule_domain"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_search_box"
        android:hint="@string/enter_domain_hint"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:singleLine="true"
        android:textColor="?attr/theme_text_primary"
        android:textColorHint="?attr/theme_text_muted"
        android:textSize="14sp" />

</LinearLayout>
