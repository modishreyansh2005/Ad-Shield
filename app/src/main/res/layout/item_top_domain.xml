<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_top_domain_rank"
            android:layout_width="24dp"
            android:layout_height="wrap_content"
            android:textColor="?attr/theme_text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1." />

        <TextView
            android:id="@+id/tv_top_domain_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="?attr/theme_text_primary"
            android:textSize="14sp"
            tools:text="googleads.g.doubleclick.net" />

        <TextView
            android:id="@+id/tv_top_domain_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/status_blocked"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="142" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progress_top_domain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:indicatorColor="@color/status_blocked"
        app:trackColor="?attr/theme_border"
        app:trackCornerRadius="4dp"
        app:trackThickness="4dp"
        tools:progress="65" />

</LinearLayout>
